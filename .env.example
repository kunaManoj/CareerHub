# CareerHub — environment variables
# Copy to .env.local for local development. All prefixed VITE_ are exposed to the client.

# --- Backend (Supabase) -------------------------------------------------
# Required for the app to load the live board. Without these values, the app
# shows its backend setup screen instead of serving bundled or local data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Build ---------------------------------------------------------------
VITE_APP_ENV=development
