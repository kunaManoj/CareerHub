# CareerHub — environment variables
# Copy to .env.local for local development. All prefixed VITE_ are exposed to the client.

# --- Backend (Supabase) -------------------------------------------------
# Only required once you switch src/services/api.ts from the bundled
# client persistence mode to the live API. The app runs fully without them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Build ---------------------------------------------------------------
VITE_APP_ENV=development
